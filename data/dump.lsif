{"id":3277,"type":"vertex","label":"range","start":{"line":293,"character":4},"end":{"line":293,"character":10},"tag":{"type":"definition","text":"engine","kind":7,"fullRange":{"start":{"line":293,"character":0},"end":{"line":293,"character":10}}}}
