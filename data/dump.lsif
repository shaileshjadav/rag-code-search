{"id":5517,"type":"vertex","label":"hoverResult","result":{"contents":[{"language":"typescript","value":"(local function) is(types: any, ...args: any[]): string | false"},"Check if the incoming request contains the \"Content-Type\"\nheader field, and it contains the given mime `type`.\n\nExamples:\n\n     // With Content-Type: text/html; charset=utf-8\n     req.is('html');\n     req.is('text/html');\n     req.is('text/*');\n     // => true\n\n     // When Content-Type is application/json\n     req.is('json');\n     req.is('application/json');\n     req.is('application/*');\n     // => true\n\n     req.is('html');\n     // => false"]}}
